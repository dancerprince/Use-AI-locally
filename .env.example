# Copy to backend/.env. All variables are optional. Lists are JSON.

# --- Server ---
OAI_HOST=127.0.0.1                 # keep loopback unless you set OAI_API_TOKEN
OAI_PORT=8000
OAI_DATA_DIR=./data                # SQLite DB + generated secret.key
OAI_LOG_LEVEL=INFO
OAI_LOG_JSON=false
# OAI_API_TOKEN=change-me          # require "Authorization: Bearer <token>" on /api
# OAI_SECRET_KEY=                  # Fernet key; auto-generated in data dir if unset
# OAI_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# OAI_CORS_ORIGINS=["http://localhost:5173"]

# --- Model (defaults; editable in the UI Settings page) ---
OAI_MODEL_PROVIDER=ollama          # ollama | openai (LM Studio, llama.cpp, vLLM...)
OAI_MODEL_BASE_URL=http://localhost:11434
# OAI_DEFAULT_MODEL=llama3.1:8b
OAI_MODEL_TIMEOUT_S=180
OAI_PING_TIMEOUT_S=3
OAI_MAX_TOOL_ROUNDS=6

# --- Tools ---
OAI_TOOL_TIMEOUT_S=60
OAI_MCP_CONNECT_TIMEOUT_S=20
# OAI_MCP_STDIO_ALLOWED_COMMANDS=["npx","uvx","node","python","docker"]
# OAI_HTTP_ALLOWED_HOSTS=["api.example.com"]   # empty = any host
